+<?php
+/**
+ * Plugin Name: Hotfix Old Forms (CVE-2026-90003)
+ * Description: Restricts the old-forms of_save_field AJAX action to its legitimate draft keys (of_draft_*).
+ */
+if ( ! defined( 'ABSPATH' ) ) { exit; }
+
+function hotfix_of_guard_save_field() {
+	$key = sanitize_key( wp_unslash( $_POST['key'] ?? '' ) );
+	// Only allow draft autosave keys; reject anything else (e.g. users_can_register, default_role).
+	if ( ! preg_match( '/^of_draft_[a-z0-9_-]{1,64}$/', $key ) ) {
+		wp_send_json_error( array( 'message' => 'Invalid key' ), 403 );
+	}
+	$_POST['key'] = $key;
+}
+add_action( 'wp_ajax_of_save_field', 'hotfix_of_guard_save_field', 1 );
+add_action( 'wp_ajax_nopriv_of_save_field', 'hotfix_of_guard_save_field', 1 );
