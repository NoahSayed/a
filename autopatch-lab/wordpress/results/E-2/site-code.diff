+<?php
+/**
+ * Hotfix for CVE-2026-90003 (Old Forms <= 1.4.2, no fixed release).
+ *
+ * The of_save_field AJAX action (logged-in and anonymous) accepted any key and
+ * called update_option() with it, so anyone could change arbitrary options such
+ * as default_role. The plugin is abandoned, so instead of editing it this file
+ * swaps its handler for one that only writes the draft keys the form uses
+ * (of_draft_<form id>). Any other key is refused.
+ */
+if ( ! defined( 'ABSPATH' ) ) { exit; }
+
+function hotfix_of_save_field_restricted() {
+	$key   = sanitize_key( wp_unslash( $_POST['key'] ?? '' ) );
+	$value = sanitize_text_field( wp_unslash( $_POST['value'] ?? '' ) );
+	if ( ! preg_match( '/^of_draft_[a-z0-9_-]{1,60}$/', $key ) || strlen( $value ) > 10000 ) {
+		wp_send_json_error( null, 400 );
+	}
+	update_option( $key, $value );
+	wp_send_json_success();
+}
+
+// mu-plugins load before regular plugins, so wait until Old Forms has registered its handlers.
+add_action( 'plugins_loaded', function () {
+	if ( ! function_exists( 'of_save_field' ) ) {
+		return; // Old Forms is not active, so there is no handler to replace.
+	}
+	remove_action( 'wp_ajax_of_save_field', 'of_save_field' );
+	remove_action( 'wp_ajax_nopriv_of_save_field', 'of_save_field' );
+	add_action( 'wp_ajax_of_save_field', 'hotfix_of_save_field_restricted' );
+	add_action( 'wp_ajax_nopriv_of_save_field', 'hotfix_of_save_field_restricted' );
+}, 1 );
