+<?php
+/*
+Plugin Name: Hotfix Old Forms (CVE-2026-90003)
+Description: Restricts Old Forms' of_save_field AJAX action to its legitimate of_draft_* option keys.
+*/
+if ( ! defined( 'ABSPATH' ) ) { exit; }
+
+add_action( 'admin_init', function () {
+	if ( ! wp_doing_ajax() ) {
+		return;
+	}
+	$action = isset( $_REQUEST['action'] ) ? sanitize_key( wp_unslash( $_REQUEST['action'] ) ) : '';
+	if ( 'of_save_field' !== $action ) {
+		return;
+	}
+	$raw = isset( $_POST['key'] ) ? wp_unslash( $_POST['key'] ) : '';
+	$key = is_string( $raw ) ? sanitize_key( $raw ) : '';
+	// Only allow draft keys, and the key must be unchanged by sanitizing.
+	if ( $key !== $raw || ! preg_match( '/^of_draft_[a-z0-9_-]{1,64}$/', $key ) ) {
+		wp_send_json_error( array( 'message' => 'Invalid key' ), 403 );
+	}
+}, 0 );
