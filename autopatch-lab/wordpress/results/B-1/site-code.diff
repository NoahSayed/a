+<?php
+/**
+ * Hotfix for CVE-2026-90003 (Old Forms <= 1.4.2): of_save_field allowed
+ * unauthenticated updates of arbitrary options. Only draft keys are allowed.
+ */
+if ( ! defined( 'ABSPATH' ) ) { exit; }
+
+add_action( 'admin_init', function () {
+	if ( ! defined( 'DOING_AJAX' ) || ! DOING_AJAX ) {
+		return;
+	}
+	if ( ( $_REQUEST['action'] ?? '' ) !== 'of_save_field' ) {
+		return;
+	}
+	$raw = $_POST['key'] ?? '';
+	$key = is_string( $raw ) ? sanitize_key( wp_unslash( $raw ) ) : '';
+	$val = $_POST['value'] ?? '';
+	if ( ! preg_match( '/^of_draft_[a-z0-9_-]{1,64}$/', $key ) || ! is_string( $val ) || strlen( $val ) > 5000 ) {
+		wp_send_json_error( null, 403 );
+	}
+}, 0 );
