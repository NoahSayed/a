+<?php
+/**
+ * Hotfix for CVE-2026-90003 (Old Forms <= 1.4.2 - abandoned, no fixed version).
+ *
+ * Old Forms registers an AJAX action `of_save_field` (for both logged-in and
+ * logged-out requests) that takes a `key` straight from $_POST (sanitized
+ * only with sanitize_key(), which does not restrict *which* option name may
+ * be targeted) and calls update_option( $key, $value ) unconditionally. This
+ * lets an unauthenticated attacker overwrite arbitrary options (e.g.
+ * users_can_register / default_role) and escalate to admin.
+ *
+ * The plugin's own code only ever sends this action with keys shaped like
+ * `of_draft_<form id>` (see the comment above of_save_field() in
+ * old-forms.php) to autosave a visitor's half-filled form. That is the only
+ * legitimate use of this action, and it is intentionally available to
+ * logged-out visitors, so the fix below is a strict key allow-list rather
+ * than a capability/auth check.
+ *
+ * This file does not modify the plugin, core, or the database: it detaches
+ * the vulnerable handler from both AJAX hooks and installs a replacement
+ * that only forwards to the real of_save_field() when the requested option
+ * key matches the plugin's own legitimate key shape.
+ *
+ * Residual, accepted risk: the allow-list permits any suffix after
+ * `of_draft_` (e.g. `of_draft_users_can_register`), since form IDs are
+ * arbitrary site content, not a fixed enumerable list. This cannot be used
+ * for privilege escalation because WordPress core only ever reads the
+ * literal option names (`users_can_register`, `default_role`, etc.), never
+ * an `of_draft_`-prefixed variant — it only allows unauthenticated creation
+ * of extra `of_draft_*` rows in wp_options, which is inherent to the
+ * plugin's own design and not part of this CVE.
+ */
+
+if ( ! defined( 'ABSPATH' ) ) { exit; }
+
+add_action(
+	'plugins_loaded',
+	function () {
+		if ( ! function_exists( 'of_save_field' ) ) {
+			// Plugin not active / not present: nothing to neutralize.
+			return;
+		}
+
+		// Detach the original, unrestricted handler from both the
+		// authenticated and unauthenticated AJAX routes. Priority must
+		// match the plugin's add_action() calls (both default to 10).
+		remove_action( 'wp_ajax_of_save_field', 'of_save_field', 10 );
+		remove_action( 'wp_ajax_nopriv_of_save_field', 'of_save_field', 10 );
+
+		$of_save_field_guarded = function () {
+			$key = sanitize_key( wp_unslash( $_POST['key'] ?? '' ) );
+
+			// Only allow the exact key shape the plugin's own form script
+			// sends for legitimate draft autosaves: of_draft_<form id>.
+			// sanitize_key() already lowercases and strips anything
+			// outside [a-z0-9_-], so this is a plain prefix/non-empty
+			// suffix check, not a new/separate sanitizer.
+			if ( ! preg_match( '/^of_draft_[a-z0-9_-]+$/', $key ) ) {
+				wp_send_json_error( null, 403 );
+			}
+
+			// Key validated: delegate to the real, unmodified handler so
+			// legitimate autosave behavior (including its own
+			// sanitize_text_field() on value) is unchanged.
+			of_save_field();
+		};
+
+		add_action( 'wp_ajax_of_save_field', $of_save_field_guarded );
+		add_action( 'wp_ajax_nopriv_of_save_field', $of_save_field_guarded );
+	}
+);
