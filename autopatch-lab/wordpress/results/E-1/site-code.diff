+<?php
+/**
+ * Plugin Name: Hotfix for Old Forms (CVE-2026-90003)
+ * Description: Replaces the unauthenticated of_save_field AJAX handler of the abandoned
+ *              "old-forms" plugin (<= 1.4.2) with one that may only write the plugin's own
+ *              draft-autosave options (keys beginning with "of_draft_"). Arbitrary option
+ *              updates, such as default_role or users_can_register, are refused.
+ *
+ * The plugin file itself is not modified. This mu-plugin only swaps the handler at runtime.
+ */
+
+if ( ! defined( 'ABSPATH' ) ) {
+	exit;
+}
+
+/**
+ * Hardened replacement for the plugin's of_save_field() handler.
+ *
+ * Same request contract as the original (POST: key, value; JSON response), but the key
+ * must be a draft-autosave key. Anything else is rejected before update_option() runs.
+ */
+function hotfix_of_save_field() {
+	$key   = sanitize_key( wp_unslash( $_POST['key'] ?? '' ) );
+	$value = sanitize_text_field( wp_unslash( $_POST['value'] ?? '' ) );
+
+	// Only the draft-autosave namespace (of_draft_<form id>) may be written.
+	if ( ! preg_match( '/^of_draft_[a-z0-9_\-]{1,100}$/', $key ) ) {
+		wp_send_json_error( null, 400 );
+	}
+
+	update_option( $key, $value );
+	wp_send_json_success();
+}
+
+/**
+ * Swap the plugin's handlers for the hardened one. Runs after all active plugins have
+ * registered their hooks, so the original handler is present to be removed.
+ * Does nothing if the old-forms plugin is not active.
+ */
+function hotfix_old_forms_swap_handler() {
+	if ( ! function_exists( 'of_save_field' ) ) {
+		return;
+	}
+	remove_action( 'wp_ajax_of_save_field', 'of_save_field', 10 );
+	remove_action( 'wp_ajax_nopriv_of_save_field', 'of_save_field', 10 );
+	add_action( 'wp_ajax_of_save_field', 'hotfix_of_save_field' );
+	add_action( 'wp_ajax_nopriv_of_save_field', 'hotfix_of_save_field' );
+}
+add_action( 'plugins_loaded', 'hotfix_old_forms_swap_handler', 999 );
