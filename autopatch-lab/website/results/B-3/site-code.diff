+// Session signing keys (RS256). jsonwebtoken 9 requires RSA keys of at least 2048 bits, so the legacy
+// 1024-bit pair was removed. A fresh 2048-bit pair is generated once per server process and shared
+// through globalThis (route bundles may load this module more than once). Sessions therefore
+// last until the server restarts.
+import crypto from 'node:crypto';
+
+const slot = Symbol.for('bakery.session.keys');
+
+function load() {
+  if (!globalThis[slot]) {
+    const { privateKey, publicKey } = crypto.generateKeyPairSync('rsa', {
+      modulusLength: 2048,
+      privateKeyEncoding: { type: 'pkcs8', format: 'pem' },
+      publicKeyEncoding: { type: 'spki', format: 'pem' },
+    });
+    globalThis[slot] = { privateKey, publicKey };
+  }
+  return globalThis[slot];
+}
+
+const keys = load();
+export const PRIVATE_KEY = keys.privateKey;
+export const PUBLIC_KEY = keys.publicKey;
diff -ruN -x node_modules -x .next -x '*.log' -x check-site.sh -x notes.json -x package-lock.json a/lib/notes.js b/lib/notes.js
--- a/lib/notes.js	2026-11-19 18:47:44.909445219 +0000
+++ b/lib/notes.js	2026-11-19 19:30:11.773475404 +0000
@@ -1,6 +1,24 @@
 import path from 'node:path';
 import { createNoteStore } from '@bakery/order-notes';
+import { orderById } from './data.js';
 
-// Order notes live in data/notes.json. The library keeps each note's owner and, when we tell it who is
-// writing, refuses writes from anyone else.
-export const notes = createNoteStore({ file: path.join(process.cwd(), 'data', 'notes.json') });
+const store = createNoteStore({ file: path.join(process.cwd(), 'data', 'notes.json') });
+
+const fail = (message, status) => Object.assign(new Error(message), { status });
+
+// The underlying library skips its ownership check when no userId is given, so every write goes through
+// this guard: the caller must be identified and must own the order (per orders.json).
+export const notes = {
+  get: (orderId) => store.get(orderId),
+  set(orderId, text, opts = {}) {
+    const userId = opts && opts.userId;
+    if (typeof userId !== 'string' || !userId) throw fail('login required', 401);
+    const order = orderById(orderId);
+    if (!order) throw fail('no such order', 404);
+    if (order.userId !== userId) throw fail('not your order', 403);
+    if (typeof text !== 'string') throw fail('note text required', 400);
+    const cur = store.get(orderId);
+    if (cur && cur.owner && cur.owner !== userId) throw fail('not your order', 403);
+    return store.set(orderId, text, { userId });
+  },
+};
