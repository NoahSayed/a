+import crypto from 'node:crypto';
+
+// Session signing keys (RS256). jsonwebtoken 9 refuses RSA keys under 2048 bits, so the legacy 1024-bit
+// pair was removed. A fresh 2048-bit pair is generated when the server starts and cached on globalThis so
+// every route bundle shares the same pair. Sessions issued before a restart are therefore no longer valid
+// and users need to log in again.
+const pair =
+  globalThis.__bakerySessionKeys ||
+  (globalThis.__bakerySessionKeys = crypto.generateKeyPairSync('rsa', {
+    modulusLength: 2048,
+    publicKeyEncoding: { type: 'spki', format: 'pem' },
+    privateKeyEncoding: { type: 'pkcs8', format: 'pem' },
+  }));
+
+export const PRIVATE_KEY = pair.privateKey;
+export const PUBLIC_KEY = pair.publicKey;
diff -ruN -x node_modules -x .next -x '*.log' -x check-site.sh -x notes.json -x package-lock.json a/lib/notes.js b/lib/notes.js
--- a/lib/notes.js	2026-11-19 18:47:44.909445219 +0000
+++ b/lib/notes.js	2026-11-19 19:45:49.981531174 +0000
@@ -1,6 +1,33 @@
 import path from 'node:path';
 import { createNoteStore } from '@bakery/order-notes';
+import { orderById } from './data.js';
 
-// Order notes live in data/notes.json. The library keeps each note's owner and, when we tell it who is
-// writing, refuses writes from anyone else.
-export const notes = createNoteStore({ file: path.join(process.cwd(), 'data', 'notes.json') });
+// Order notes live in data/notes.json. @bakery/order-notes is abandoned and only checks ownership when it is
+// given a userId, so it must not be trusted on its own: every write goes through saveOrderNote below, which
+// checks the caller and the order before the library is called.
+const store = createNoteStore({ file: path.join(process.cwd(), 'data', 'notes.json') });
+
+// Read-only view. Nothing outside this file can write to the store.
+export const notes = { get: (orderId) => store.get(orderId) };
+
+export const MAX_NOTE_LENGTH = 1000;
+
+function fail(status, message) {
+  return Object.assign(new Error(message), { status });
+}
+
+/**
+ * Saves the note for one order on behalf of a logged-in customer. Only the customer who owns the order may
+ * write its note. Throws an error with a `status` property when the write is refused.
+ */
+export function saveOrderNote({ orderId, text, userId }) {
+  if (typeof userId !== 'string' || userId === '') throw fail(401, 'login required');
+  const order = orderById(orderId);
+  if (!order) throw fail(404, 'no such order');
+  if (order.userId !== userId) throw fail(403, 'not your order');
+  if (typeof text !== 'string' || text.length > MAX_NOTE_LENGTH) {
+    throw fail(400, `note must be text of at most ${MAX_NOTE_LENGTH} characters`);
+  }
+  // Always pass the verified user and the order's canonical id.
+  return store.set(String(order.id), text, { userId });
+}
