+// Session signing keys (RS256). jsonwebtoken 9 requires RSA keys of at least 2048 bits, so the legacy
+// 1024-bit pair is replaced by a 2048-bit pair generated once per server process and shared by every
+// route bundle through globalThis. Sessions therefore last until the server restarts.
+import { generateKeyPairSync } from 'node:crypto';
+
+const SLOT = Symbol.for('bakery.session.keys');
+
+function load() {
+  if (!globalThis[SLOT]) {
+    const { privateKey, publicKey } = generateKeyPairSync('rsa', {
+      modulusLength: 2048,
+      privateKeyEncoding: { type: 'pkcs8', format: 'pem' },
+      publicKeyEncoding: { type: 'spki', format: 'pem' },
+    });
+    globalThis[SLOT] = { privateKey, publicKey };
+  }
+  return globalThis[SLOT];
+}
+
+const keys = load();
+export const PRIVATE_KEY = keys.privateKey;
+export const PUBLIC_KEY = keys.publicKey;
