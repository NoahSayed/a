+import crypto from 'node:crypto';
+
+// Session signing keys (RS256). jsonwebtoken 9 requires RSA keys of at least 2048 bits, and the old
+// 1024-bit pair hard-coded here was rejected, so no session could be issued. No key material is stored
+// in the source: a fresh 2048-bit pair is generated the first time it is needed and kept for the life of
+// the server process. Sessions issued before a restart therefore stop working after it and users log in
+// again. The pair is cached on globalThis so every module instance in the process shares the same keys.
+const CACHE = Symbol.for('bakery.sessionKeys');
+
+function sessionKeys() {
+  if (!globalThis[CACHE]) {
+    const { publicKey, privateKey } = crypto.generateKeyPairSync('rsa', {
+      modulusLength: 2048,
+      publicKeyEncoding: { type: 'spki', format: 'pem' },
+      privateKeyEncoding: { type: 'pkcs8', format: 'pem' },
+    });
+    globalThis[CACHE] = { PRIVATE_KEY: privateKey, PUBLIC_KEY: publicKey };
+  }
+  return globalThis[CACHE];
+}
+
+export const getPrivateKey = () => sessionKeys().PRIVATE_KEY;
+export const getPublicKey = () => sessionKeys().PUBLIC_KEY;
diff -ruN -x node_modules -x .next -x '*.log' -x check-site.sh -x notes.json -x package-lock.json a/lib/notes.js b/lib/notes.js
--- a/lib/notes.js	2026-11-19 18:47:44.909445219 +0000
+++ b/lib/notes.js	2026-11-19 19:51:03.054243176 +0000
@@ -1,6 +1,36 @@
 import path from 'node:path';
 import { createNoteStore } from '@bakery/order-notes';
+import { orderById } from './data.js';
 
 // Order notes live in data/notes.json. The library keeps each note's owner and, when we tell it who is
 // writing, refuses writes from anyone else.
 export const notes = createNoteStore({ file: path.join(process.cwd(), 'data', 'notes.json') });
+
+export const MAX_NOTE_LENGTH = 500;
+
+function httpError(message, status) {
+  return Object.assign(new Error(message), { status });
+}
+
+/**
+ * Saves a customer's note on one of their own orders.
+ *
+ * @bakery/order-notes 2.1.0 only checks ownership when it is given a userId; a write without one goes
+ * through for any order. This is the only write path the site uses, and it refuses the write here, in
+ * application code, before the library is called: the caller must be signed in, the order must exist and
+ * belong to the caller, an existing note must belong to the caller, and the text must be a bounded string.
+ * The library is then always called with the verified userId.
+ */
+export function setOrderNote(orderId, text, session) {
+  if (!session?.sub) throw httpError('login required', 401);
+  if (typeof text !== 'string' || text.length > MAX_NOTE_LENGTH) throw httpError('invalid note', 400);
+
+  const order = orderById(orderId);
+  if (!order) throw httpError('no such order', 404);
+  if (order.userId !== session.sub) throw httpError('forbidden', 403);
+
+  const current = notes.get(orderId);
+  if (current && current.owner !== session.sub) throw httpError('not your order', 403);
+
+  return notes.set(orderId, text, { userId: session.sub });
+}
