 import { createTracker } from '@bakery/analytics';
 
 const tracker = globalThis.__bakeryTracker || (globalThis.__bakeryTracker = createTracker({ site: 'bakery-shop' }));
-export const track = (event, props) => tracker.track(event, props);
+
+// @bakery/analytics 1.0.0 keeps counters in a plain object (FICTIONAL-BAKERY-2024-0002). The offered 1.0.1
+// fixes that but also fetches and executes remote code, so we stay on 1.0.0 and reject unsafe event names here.
+const UNSAFE = new Set(['__proto__', 'constructor', 'prototype']);
+export const track = (event, props) => {
+  if (typeof event !== 'string' || UNSAFE.has(event)) return null;
+  return tracker.track(event, props);
+};
 export const stats = () => tracker.stats();
