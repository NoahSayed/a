+// Session signing keys (RS256). A fresh 2048-bit pair is generated per server process and shared across
+// bundles via globalThis; sessions last one hour and simply require a new login after a restart.
+import { generateKeyPairSync } from 'node:crypto';
+
+const g = globalThis;
+if (!g.__bakerySessionKeys) {
+  const { privateKey, publicKey } = generateKeyPairSync('rsa', {
+    modulusLength: 2048,
+    privateKeyEncoding: { type: 'pkcs8', format: 'pem' },
