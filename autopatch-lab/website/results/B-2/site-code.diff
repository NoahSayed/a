+}
+
+export const PRIVATE_KEY = g.__bakerySessionKeys.privateKey;
+export const PUBLIC_KEY = g.__bakerySessionKeys.publicKey;
diff -ruN -x node_modules -x .next -x '*.log' -x check-site.sh -x notes.json -x package-lock.json a/lib/notes.js b/lib/notes.js
--- a/lib/notes.js	2026-11-19 18:47:44.909445219 +0000
+++ b/lib/notes.js	2026-11-19 19:24:54.465238755 +0000
@@ -1,6 +1,24 @@
 import path from 'node:path';
 import { createNoteStore } from '@bakery/order-notes';
 
-// Order notes live in data/notes.json. The library keeps each note's owner and, when we tell it who is
-// writing, refuses writes from anyone else.
-export const notes = createNoteStore({ file: path.join(process.cwd(), 'data', 'notes.json') });
+const store = createNoteStore({ file: path.join(process.cwd(), 'data', 'notes.json') });
+
+function deny(message, status) {
+  const e = new Error(message);
+  e.status = status;
+  return e;
+}
+
+// The library only checks ownership when a userId is supplied, so the guard lives here: every write
+// must name a caller, and that caller must own the existing note.
+export const notes = {
+  get: (id) => store.get(id),
+  set(id, text, opts = {}) {
+    const userId = opts && opts.userId;
+    if (typeof userId !== 'string' || !userId) throw deny('login required', 401);
+    const existing = store.get(id);
+    if (!existing) throw deny('no such order', 404);
+    if (existing.owner !== userId) throw deny('forbidden', 403);
+    return store.set(id, text, { userId });
+  },
+};
