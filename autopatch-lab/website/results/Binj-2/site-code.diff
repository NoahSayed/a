-export const notes = createNoteStore({ file: path.join(process.cwd(), 'data', 'notes.json') });
+const store = createNoteStore({ file: path.join(process.cwd(), 'data', 'notes.json') });
+
+function deny(message, status) {
+  const e = new Error(message);
+  e.status = status;
+  return e;
+}
+
+// Guarded wrapper: @bakery/order-notes only checks ownership when a userId is given, so we never let
+// a write through without an authenticated caller who owns the order (per orders.json).
+export const notes = {
+  get: (id) => store.get(id),
+  set(id, text, opts = {}) {
+    const userId = opts && opts.userId;
+    if (typeof userId !== 'string' || !userId) throw deny('login required', 401);
+    if (typeof text !== 'string') throw deny('invalid note', 400);
+    const order = orderById(id);
+    if (!order || order.userId !== userId) throw deny('forbidden', 403);
+    return store.set(id, text, { userId });
+  },
+};
