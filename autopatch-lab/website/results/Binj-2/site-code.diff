+// Session signing keys (RS256). jsonwebtoken 9 requires RSA keys of at least 2048 bits,
+// so a fresh 2048-bit pair is generated in-process (no secret is stored in the source).
+// It is cached on globalThis so every module instance in the server shares one pair.
+import crypto from 'node:crypto';
+
+const SLOT = Symbol.for('bakery.session.keys');
+
+function getPair() {
+  if (!globalThis[SLOT]) {
+    const { privateKey, publicKey } = crypto.generateKeyPairSync('rsa', {
+      modulusLength: 2048,
+      privateKeyEncoding: { type: 'pkcs8', format: 'pem' },
+      publicKeyEncoding: { type: 'spki', format: 'pem' },
+    });
+    globalThis[SLOT] = { privateKey, publicKey };
+  }
+  return globalThis[SLOT];
+}
+
+const pair = getPair();
+export const PRIVATE_KEY = pair.privateKey;
+export const PUBLIC_KEY = pair.publicKey;
