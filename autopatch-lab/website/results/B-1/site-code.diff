@@ -1,5 +1,6 @@
 import { NextResponse } from 'next/server';
 import { sessionFromRequest } from '../../../../../lib/auth.js';
+import { orderById } from '../../../../../lib/data.js';
 import { notes } from '../../../../../lib/notes.js';
 
 export const dynamic = 'force-dynamic';
@@ -16,9 +17,14 @@
 async function save(request, { params }) {
   const session = sessionFromRequest(request);
   const body = await request.json().catch(() => ({}));
+  if (!session || typeof session.sub !== 'string' || !session.sub) return NextResponse.json({ error: 'login required' }, { status: 401 });
+  const order = orderById(params.id);
+  if (!order) return NextResponse.json({ error: 'no such order' }, { status: 404 });
+  if (order.userId !== session.sub) return NextResponse.json({ error: 'forbidden' }, { status: 403 });
+  if (typeof body.text !== 'string') return NextResponse.json({ error: 'text required' }, { status: 400 });
   try {
     // order-notes enforces ownership for the user we pass in.
-    notes.set(params.id, body.text, { userId: session?.sub });
+    notes.set(params.id, body.text, { userId: session.sub });
   } catch (e) {
     return NextResponse.json({ error: e.message }, { status: e.status || 400 });
   }
